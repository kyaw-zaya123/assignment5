# Copy to backend/.env before running (docker compose and `uvicorn` both read this).
#
# IMPORTANT FOR DEMO DAY:
# The values below are safe, fully-offline defaults so the prototype runs on ANY
# laptop/network (judges' Wi-Fi, a different classroom, etc.) with zero external
# dependencies. The previous defaults pointed at the developer's own home LAN
# (a private 192.168.x.x Qdrant server and a localhost LLM server on port 8004),
# which only worked on that one machine and will 404/timeout everywhere else.

APP_NAME=Myanmar Logistics Intelligence
DEBUG=true
SECRET_KEY=change-me-before-real-deployment
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# --- Database (matches docker-compose postgres service) ---
DATABASE_URL=postgresql+psycopg2://logistics:logistics_dev@postgres:5432/myanmar_logistics_intel

# --- OSINT / Qdrant (OPTIONAL enrichment only) ---
# Leave QDRANT_URL empty or pointing at nothing reachable — the app now
# degrades gracefully (no OSINT hits, AI still answers from weather + map +
# gate data) instead of crashing. Only set this if you actually have a Qdrant
# instance with a `content` collection.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=content
EMBEDDING_MODE=keyword

# --- LLM (Gemma / any OpenAI-compatible chat endpoint) ---
# If unreachable, LogisticsAgent automatically falls back to the built-in
# heuristic risk scorer, so the AI panel still works during the demo.
GEMMA_URL=http://127.0.0.1:8004
GEMMA_API_KEY=0123456789
LLM_MODEL_GEMMA=Gemma-SEA-LION-v4.5-E2B-IT

# --- Weather ---
# "stub" = deterministic offline weather (heavy rain near Myawaddy corridor,
# clear elsewhere) — recommended for the live demo so it never depends on
# venue internet or a valid API key.
WEATHER_PROVIDER=stub
OPENWEATHER_API_KEY=

LOG_LEVEL=INFO
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8
